# Copy to .env (or set these in your shell) and fill in your key.
# Get a key at https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides -------------------------------------------------------
# OpenAI-compatible endpoint (do not add /chat/completions)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Main agent model: deepseek-flash | deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Cheaper model used for titles / compaction
DEEPSEEK_SMALL_MODEL=deepseek-flash

# Thinking mode: enabled | disabled
DEEPSEEK_THINKING=enabled

# Reasoning effort: low | medium | high
DEEPSEEK_EFFORT=high

# Max output tokens for one assistant turn (DeepSeek allows up to 384000)
DEEPSEEK_MAX_TOKENS=16384

# Permission mode: plan | default | acceptEdits | bypassPermissions
DEEPSEEK_PERMISSION_MODE=default

# Max agent steps (model<->tool round trips) per user message
DEEPSEEK_MAX_STEPS=60
